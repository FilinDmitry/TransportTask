<Page x:Class="TransportTask.Pages.RaschetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TransportTask.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="430" d:DesignWidth="800"
      Title="RaschetPage">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="20"></Setter>
            <Setter Property="Height" Value="30"></Setter>
            <Setter Property="FontSize" Value="18"></Setter>
            <Setter Property="FontFamily" Value="Segoe UI Light"></Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="AUTO"></RowDefinition>
        </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Кол-во столбцов"></TextBlock>
                <TextBox PreviewTextInput="TB_PreviewTextInput" x:Name="TBColumns" TextChanged="TextBox_TextChanged" Width="50"></TextBox>
            </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <TextBlock Text="Кол-во строк"></TextBlock>
            <TextBox Name="TBRows" PreviewTextInput="TB_PreviewTextInput" TextChanged="TextBox_TextChanged" Width="50"></TextBox>
        </StackPanel>

        <Grid Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="MainGrid" Grid.Row="1">
            
        </Grid>

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="3">
            <Button Content="Импорт из Excel"></Button>
            <Button Content="Экспорт в Excel"></Button>
            <Button Content="Рассчитать"></Button>
            <Button Content="Очистить"></Button>
        </StackPanel>
    </Grid>
</Page>
